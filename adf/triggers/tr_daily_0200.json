{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/authorizationTemplateParameters.json#",
  "contentVersion": "1.0.0.0",
  "name": "TR_Daily_0200",
  "type": "Microsoft.DataFactory/factories/triggers",
  "properties": {
    "description": "Schedule Trigger for the SEC EDGAR copy pipeline. Runs daily at 02:00 UTC (BR-05). SEC filings do not update intra-day so a low frequency is sufficient.",
    "type": "ScheduleTrigger",
    "typeProperties": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2026-01-01T02:00:00Z",
        "timeZone": "UTC",
        "schedule": {
          "hours": [2]
        }
      }
    },
    "pipelines": [
      {
        "pipelineReference": {
          "referenceName": "PL_CopyRawToStaging",
          "type": "PipelineReference"
        },
        "parameters": {}
      }
    ]
  }
}
