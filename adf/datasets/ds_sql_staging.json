{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/authorizationTemplateParameters.json#",
  "contentVersion": "1.0.0.0",
  "name": "DS_Sql_Staging",
  "type": "Microsoft.DataFactory/factories/datasets",
  "properties": {
    "type": "AzureSqlTable",
    "linkedServiceName": {
      "referenceName": "LS_AzureSql",
      "type": "LinkedServiceReference"
    },
    "typeProperties": {
      "tableName": "[dbo].[staging]"
    },
    "schema": [
      { "name": "cik", "type": "Int64" },
      { "name": "company_name", "type": "String" },
      { "name": "tag_used", "type": "String" },
      { "name": "fiscal_year", "type": "Int32" },
      { "name": "fiscal_period", "type": "String" },
      { "name": "form_type", "type": "String" },
      { "name": "end_date", "type": "Date" },
      { "name": "filed_date", "type": "Date" },
      { "name": "value", "type": "Decimal" },
      { "name": "unit", "type": "String" },
      { "name": "ingested_at", "type": "DateTime" }
    ],
    "description": "Staging table for normalized SEC EDGAR facts (US-03). Allows NULLs to tolerate schema drift across filers (BR-02)."
  }
}
