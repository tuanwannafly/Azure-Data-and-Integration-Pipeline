# =============================================================================
# Environment variables template — copy to `.env` and fill in real values.
# `.env` is git-ignored (BR-01). NEVER commit real secrets.
# For CI/CD, set the same keys as GitHub Actions Repository Secrets.
# =============================================================================

# ---- US-01: SEC EDGAR adapter (batch) ----
# SEC policy requires a valid User-Agent header, format: "Project Name email@domain.com"
# Missing/invalid format -> HTTP 403 (BR-07).
SEC_EDGAR_USER_AGENT="Azure Data Integration Demo your_email@example.com"

# ---- US-02: Azure Blob Storage ingest ----
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=stdataintegration01;AccountKey=REPLACE_ME;EndpointSuffix=core.windows.net"

# ---- US-03/04/09: Azure SQL Database ----
# JDBC or pyodbc connection string. Includes staging, transformed, live_ticks tables.
AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:sql-dataintegration-dev.database.windows.net,1433;Database=sqldb-dataintegration;Uid=REPLACE_ME;Pwd=REPLACE_ME;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# ---- US-05/06: Databricks (optional, deploy notebook via script) ----
DATABRICKS_HOST="https://adb-REPLACE_ME.azuredatabricks.net"
DATABRICKS_TOKEN="REPLACE_ME"

# ---- US-07/08: Finnhub streaming + Service Bus ----
# Auth for wss://ws.finnhub.io?token=...
FINNHUB_API_KEY="REPLACE_ME"
# Comma-separated symbols to subscribe (free tier has a symbol cap).
FINNHUB_SYMBOLS="AAPL,BINANCE:BTCUSDT"
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-dataintegration-dev.servicebus.windows.net/;SharedAccessKeyName=sender;SharedAccessKey=REPLACE_ME"

# ---- US-11: APIM (optional) ----
APIM_SUBSCRIPTION_KEY="REPLACE_ME"
